<!-- Head -->
<%- include("partials/header.ejs") %>

<body class="text-center">
    <div id="content" class="bg-white">
        <!-- Heading -->
        <a href="/" class="left">Back to Search</a>
        <h1 id="mainHeading"> Quotes Found </h1>
        <hr>

        <!-- No Results Message -->
        <% if (quotes.length == 0) { %>
            <h3>No results found.</h3>
        <% } %>

        <!-- Results -->
        <% for (i of quotes) { %>
            <%= i.quote %> <br>
            -<em>
                <a href="#" id="<%= i.authorId %>" class="author">
                    <%= i.firstName %> <%= i.lastName %>
                </a>
            </em> <br><br>
        <% } %>

        <!-- Author Info -->
        <!-- Modal -->
        <div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel">Author Information</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="authorInfo"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
        

        <!-- Footer -->
        <%- include("partials/footer.ejs") %>
    </div>

    <script src="/js/author-info.js"></script>
</body>
</html>